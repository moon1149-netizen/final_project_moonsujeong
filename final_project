      "cell_type": "code",
      "source": [
        "import gradio as gr\n",
        "\n",
        "# 생명체, 추상적 단어, 개인정보 등 필터링 키워드\n",
        "invalid_keywords = ['강아지', '고양이', '사람', '사랑', '우정', '마음', '생명', '동물', '식물']\n",
        "\n",
        "# 수원시 기준 분리배출 기본 데이터베이스 (예시)\n",
        "disposal_db = {\n",
        "    '깨진 거울': {'method': '특수규격 마대 (불연성 종량제 봉투)에 담아 배출', 'sticker': '불필요'},\n",
        "    '건전지': {'method': '가까운 행정복지센터나 아파트 단지 내 전용 수거함에 배출', 'sticker': '불필요'},\n",
        "    '형광등': {'method': '깨지지 않게 주의하여 전용 수거함에 배출', 'sticker': '불필요'},\n",
        "    '선풍기': {'method': '소형 폐가전 수거함 또는 폐가전 무상수거(1599-0903) 이용', 'sticker': '불필요'},\n",
        "    '의자': {'method': '수원시 대형폐기물 인터넷 신고 또는 행정복지센터 방문 신고 후 배출', 'sticker': '필요'},\n",
        "    '이불': {'method': '의류수거함 배출 금지. 일반 종량제 봉투(소형) 또는 대형폐기물 스티커 부착(솜이불)', 'sticker': '크기에 따라 상이'}\n",
        "}\n",
        "\n",
        "def infer_method(item):\n",
        "    \"\"\"DB에 없는 품목일 경우 키워드 기반으로 추론합니다.\"\"\"\n",
        "    if any(keyword in item for keyword in ['유리', '도자기', '화분', '사기']):\n",
        "        return {'method': '특수규격 마대 (불연성 폐기물 종량제 봉투) 배출', 'sticker': '불필요'}\n",
        "    if '플라스틱' in item:\n",
        "        return {'method': '내용물을 비우고 라벨을 제거한 후 플라스틱류로 배출', 'sticker': '불필요'}\n",
        "    if any(keyword in item for keyword in ['종이', '박스', '상자']):\n",
        "        return {'method': '테이프와 택배 송장을 제거하고 펴서 종이류로 배출', 'sticker': '불필요'}\n",
        "    if any(keyword in item for keyword in ['가구', '책상', '침대', '소파']):\n",
        "        return {'method': '수원시 대형폐기물 스티커 발급 후 배출', 'sticker': '필요'}\n",
        "    if any(keyword in item for keyword in ['비닐', '봉지']):\n",
        "        return {'method': '이물질을 씻어내고 투명한 비닐봉투에 모아서 비닐류로 배출', 'sticker': '불필요'}\n",
        "\n",
        "    # 추론이 전혀 안 될 경우의 기본값\n",
        "    return {'method': '일반 종량제 봉투에 담아 배출 (부피가 큰 경우 대형폐기물 스티커 필요)', 'sticker': '확인 필요'}\n",
        "\n",
        "def guide_disposal(item_name, is_usable, is_single_material, can_disassemble):\n",
        "    # 0. 입력값 확인\n",
        "    if not item_name.strip():\n",
        "        return \"버리고 싶은 품목 이름을 입력해 주세요.\"\n",
        "\n",
        "    # 1. 생명체 및 무형의 단어 필터링\n",
        "    for kw in invalid_keywords:\n",
        "        if kw in item_name:\n",
        "            return \"❌ 정확한 품목명을 입력해 주세요. (생명체나 형태가 없는 단어는 안내할 수 없습니다.)\"\n",
        "\n",
        "    # 2. 중고 나눔 연계 로직 (\"혹시 아직 쓸만한가요?\")\n",
        "    if is_usable == '예':\n",
        "        return \"♻️ 아직 쓸만한 물건이네요!\\n\\n상태가 멀쩡한 물건은 버리기 전에 당근마켓, 중고나라 등 중고 거래 플랫폼이나 아름다운가게에 기부/나눔하는 것을 추천합니다.\\n▶ 당근마켓 바로가기: https://www.daangn.com\"\n",
        "\n",
        "    # 3. 단일 재질 및 분해 여부 로직\n",
        "    if is_single_material == '아니오':\n",
        "        if can_disassemble == '예':\n",
        "            return \"🛠️ [안내] 분해한 재질을 각각 따로 입력(검색)해서 배출 방법을 확인해 주세요! (처음으로 돌아가기)\"\n",
        "        # '아니오'일 경우 아래 분리배출 방법 안내로 넘어감\n",
        "\n",
        "    # 4. 수원시 기준 분리배출 안내 (DB 검색 및 키워드 추론)\n",
        "    item_key = item_name.strip()\n",
        "    info = disposal_db.get(item_key)\n",
        "\n",
        "    # DB에 없으면 키워드로 추론\n",
        "    if not info:\n",
        "        info = infer_method(item_key)\n",
        "\n",
        "    # 결과 출력 텍스트 구성\n",
        "    result = f\"🗑️ [{item_key}] 배출 안내 (수원시 기준)\\n\\n\"\n",
        "    result += f\"▶️ 배출 방법: {info['method']}\\n\"\n",
        "    result += f\"▶️ 대형폐기물 스티커: {info['sticker']}\\n\"\n",
        "\n",
        "    if is_single_material == '아니오' and can_disassemble == '아니오':\n",
        "         result += \"\\n💡 복합 재질이지만 분해가 어렵다면, 가장 많은 비중을 차지하는 재질을 기준으로 배출하거나 일반 종량제 봉투를 사용해 주세요.\"\n",
        "\n",
        "    return result\n",
        "\n",
        "# Gradio 인터페이스 구성 (로그인 불필요)\n",
        "with gr.Blocks(theme=gr.themes.Soft()) as app:\n",
        "    gr.Markdown(\"## ♻️ 수원시 분리배출 도우미\")\n",
        "    gr.Markdown(\"로그인 및 개인정보 입력 없이 누구나 사용할 수 있습니다. 버릴 물건의 이름을 검색하고 질문에 답해주세요!\")\n",
        "\n",
        "    with gr.Row():\n",
        "        with gr.Column():\n",
        "            item_input = gr.Textbox(label=\"1. 버리고 싶은 물건 (예: 깨진 거울, 건전지, 플라스틱 의자)\", placeholder=\"품목명 입력...\")\n",
        "            usable_input = gr.Radio([\"예\", \"아니오\"], label=\"2. 혹시 아직 쓸만한가요? (중고 거래/나눔 가능 여부)\", value=\"아니오\")\n",
        "            single_mat_input = gr.Radio([\"예\", \"아니오\"], label=\"3. 버리고 싶은 물건이 단일 재질인가요?\", value=\"예\")\n",
        "            disassemble_input = gr.Radio([\"예\", \"아니오\"], label=\"4. (단일 재질이 아니라면) 해당 물건을 분해할 수 있나요?\", value=\"아니오\")\n",
        "\n",
        "            submit_btn = gr.Button(\"배출 방법 확인하기\", variant=\"primary\")\n",
        "\n",
        "        with gr.Column():\n",
        "            result_output = gr.Textbox(label=\"결과 안내\", lines=10, interactive=False)\n",
        "\n",
        "    # 버튼 클릭 시 guide_disposal 함수 실행\n",
        "    submit_btn.click(\n",
        "        fn=guide_disposal,\n",
        "        inputs=[item_input, usable_input, single_mat_input, disassemble_input],\n",
        "        outputs=result_output\n",
        "    )\n",
        "\n",
        "# Colab에서 구동하기 위해 외부 공유 활성화\n",
        "app.launch(share=True)"
      ],
